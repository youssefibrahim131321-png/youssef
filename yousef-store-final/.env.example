# انسخ الملف ده لـ .env محليًا، وعلى Railway حطّ القيم في Variables.

NODE_ENV=production
TRUST_PROXY=1
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- قاعدة البيانات (PostgreSQL — إجباري في الإنتاج) ---
DATABASE_URL=postgres://user:pass@host:5432/db
# خلّيه 0 بس لو بتتصل بقاعدة محلية بشهادة ذاتية التوقيع
PGSSL=1

# --- التخزين الدائم (Persistent Volume) ---
DATA_DIR=/data
UPLOADS_DIR=/data/uploads/products

# --- حساب الأدمن ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# ضاعت كلمة سر الأدمن؟ حط ADMIN_PASSWORD_RESET=1 وأعد التشغيل: السيرفر هيولّد
# كلمة مرور جديدة ويطبعها في اللوج ويحفظها في DATA_DIR/INITIAL-ADMIN-PASSWORD.txt
# (الملف بيتمسح تلقائيًا أول ما تغيّرها من لوحة التحكم). شيل المتغير بعد الدخول.
ADMIN_PASSWORD_RESET=

# --- إثبات ملكية البريد ---
# مهم: وضع guard القديم كان بيعلّم البريد «مفعّل» من غير أي إثبات حقيقي —
# مجرد فحص شكل البريد. اتشال. الإثبات الحقيقي بيتم بواحدة من دول بس:
#   code   = كود 6 أرقام بيتبعت على نفس البريد (محتاج مزوّد بريد مضبوط تحت)
#   google = الدخول بحساب جوجل (جوجل هي اللي بتضمن ملكية البريد)
EMAIL_VERIFY_MODE=code
# لو 1: العميل لازم يفعّل بريده قبل ما يقدر يعمل طلب.
REQUIRE_EMAIL_VERIFICATION=1
# خلّيها 0 بس لو استضافتك بتمنع طلبات DNS
EMAIL_GUARD_MX=1
# الدخول بحساب جوجل (أقوى إثبات لملكية البريد — من غير أي رسائل)
GOOGLE_CLIENT_ID=
# كابتشا اختيارية على التسجيل (Cloudflare Turnstile، مجاني) — من غيرهم
# التسجيل شغال عادي زي ما هو، بس محمي بـ rate limiting + بوابة البريد بس.
# اعمل site في dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- البريد (مطلوب في الإنتاج لاستعادة كلمة المرور — شوف REQUIRE_MAIL_PROVIDER) ---
# لو مفيش أي مزوّد من التلاتة تحت مظبوط، السيرفر بيرفض الإقلاع في الإنتاج
# (NODE_ENV=production) لأن أي عميل ينسى كلمة مروره هيفضل عالق للأبد من غير
# تفسير. خلّي REQUIRE_MAIL_PROVIDER=0 لو متعمّد إنك تشتغل من غير بريد (تجربة
# محلية مثلًا)، أو ظبّط واحد من المزوّدين دول.
# REQUIRE_MAIL_PROVIDER=0
# (1) Resend
RESEND_API_KEY=
MAIL_FROM=متجر يوسف <no-reply@yourdomain.com>
# (2) SMTP
SMTP_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
# (3) Webhook
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# --- إشعارات Web Push (اختياري) ---
# ولّدهم بأمر: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@yourdomain.com

# --- حدود ومتغيّرات كانت مستعملة في الكود من غير ما تكون موثّقة ---
# أصل الموقع العام (بيستخدم في الروابط داخل رسائل البريد والفواتير)
PUBLIC_BASE_URL=https://your-domain.com
# (إجباري في الإنتاج) دومين الموقع الرسمي. منه بتتبني كل الروابط المطلقة
# (رابط استعادة كلمة المرور، sitemap.xml، canonical، JSON-LD). من غيره كان
# هيدر Host اللي المهاجم بيتحكم فيه هو المصدر → تسميم روابط واستيلاء حسابات.
SITE_URL=https://your-domain.com
# دومينات إضافية موثوقة مفصولة بفاصلة (لو الموقع بيتفتح على أكتر من دومين)
ALLOWED_HOSTS=
# عدد طبقات البروكسي قدام السيرفر. لازم رقم مضبوط: لو غلط، الـ rate limit
# ممكن يتخدع بترويسة X-Forwarded-For مزوّرة. 1 = بروكسي واحد (Railway/Nginx).
TRUST_PROXY=1
# أقصى حجم لملف إثبات الدفع المرفوع (بايت) — الافتراضي 3 ميجا
MAX_UPLOAD_BYTES=3145728
# مفتاح اختياري لحماية نقطة استقبال بلاغات CSP
CSP_REPORT_ENABLED=1

# --- بوابة الدفع أونلاين Paymob (مصر) — بطاقة / محفظة إلكترونية ---
# لو المتغيرات دي فاضية، خيار الدفع أونلاين بيتخفي تلقائيًا ويفضل بس
# الدفع عند الاستلام والتحويل اليدوي شغالين.
# السر الرئيسي للـ API (Settings -> Account Info -> Secret Key)
PAYMOB_SECRET_KEY=
# المفتاح العام (Settings -> Account Info -> Public Key)
PAYMOB_PUBLIC_KEY=
# رقم تكامل الدفع بالبطاقة (Developers -> Payment Integrations)
PAYMOB_CARD_INTEGRATION_ID=
# رقم تكامل المحافظ الإلكترونية (اختياري، لو مفعّل عندك)
PAYMOB_WALLET_INTEGRATION_ID=
# سر التحقق HMAC (Settings -> Account Info -> HMAC Secret)
PAYMOB_HMAC_SECRET=


# (إصلاح S2) مفتاح تشفير أسرار التحقق بخطوتين (TOTP) داخل قاعدة البيانات.
# لازم يكون نص طويل عشوائي ومختلف عن SESSION_SECRET. من غيره، الأسرار بتتشفّر
# تلقائيًا بمفتاح احتياطي مشتق من SESSION_SECRET (أضعف شوية، لكن مش نص صريح).
TOTP_ENCRYPTION_KEY=change-me-to-another-long-random-string
# سقف عدد الصفوف لكل جدول عند تصدير JSON الكامل (حماية من استهلاك الذاكرة).
EXPORT_MAX_ROWS=50000
# تكلفة bcrypt (الافتراضي 12).
BCRYPT_COST=12
